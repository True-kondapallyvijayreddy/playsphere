# Glicko ratings incl. the bounded trail. The longitudinal record talent trends are computed from.
COLLECTION_PATH=users/{uid}/ratings
TABLE_ID=ratings
WILDCARD_IDS=true

DATASET_ID=playsphere_analytics
DATASET_LOCATION=asia-south1
BIGQUERY_PROJECT_ID=playsphere-os
DATABASE=(default)
DATABASE_REGION=asia-south1

TABLE_PARTITIONING=DAY
VIEW_TYPE=view
USE_NEW_SNAPSHOT_QUERY_SYNTAX=yes
EXCLUDE_OLD_DATA=no
MAX_DISPATCHES_PER_SECOND=100
