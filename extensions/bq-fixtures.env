# Matches. The hot one — see _shared.md on cost. EXCLUDE_OLD_DATA drops the pre-image, which on a live-scored fixture is the bulk of every row.
COLLECTION_PATH=orgs/{orgId}/competitions/{compId}/fixtures
TABLE_ID=fixtures
WILDCARD_IDS=true

DATASET_ID=playsphere_analytics
DATASET_LOCATION=asia-south1
BIGQUERY_PROJECT_ID=playsphere-os
DATABASE=(default)
DATABASE_REGION=asia-south1

TABLE_PARTITIONING=DAY
VIEW_TYPE=view
USE_NEW_SNAPSHOT_QUERY_SYNTAX=yes
EXCLUDE_OLD_DATA=yes
MAX_DISPATCHES_PER_SECOND=100
