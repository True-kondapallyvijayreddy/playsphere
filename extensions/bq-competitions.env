# Events. WILDCARD_IDS carries orgId through so a competition can be attributed to a district.
COLLECTION_PATH=orgs/{orgId}/competitions
TABLE_ID=competitions
WILDCARD_IDS=true

DATASET_ID=playsphere_analytics
DATASET_LOCATION=asia-south1
BIGQUERY_PROJECT_ID=playsphere-os
DATABASE=(default)
DATABASE_REGION=asia-south1

TABLE_PARTITIONING=DAY
VIEW_TYPE=view
USE_NEW_SNAPSHOT_QUERY_SYNTAX=yes
EXCLUDE_OLD_DATA=no
MAX_DISPATCHES_PER_SECOND=100
